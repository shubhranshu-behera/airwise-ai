# GEMINI_API_KEY: Required for server-side Google Gemini API calls (multi-agent orchestration & RAG embeddings).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Model identifier for AI generation (e.g. gemini-3.6-flash, gemini-2.5-flash)
GEMINI_MODEL="gemini-3.6-flash"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Optional server-side administrator passcode override for moderation & admin controls.
# If unset, the first user can claim admin access through the in-app first-run setup form.
ADMIN_PASSCODE=""
